* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Inter, Arial, sans-serif;
  background: #101114;
  color: #f5f5f5;
}
.container { max-width: 1200px; margin: 0 auto; padding: 24px; }
.card {
  background: #181a1f;
  border: 1px solid #292c33;
  border-radius: 18px;
  padding: 22px;
}
#startScreen { max-width: 520px; margin: 10vh auto; }
h1 { margin: 0 0 8px; }
h2 { margin-top: 0; }
label { display: block; margin: 18px 0 7px; font-size: 14px; color: #c5c7cc; }
input {
  width: 100%;
  border: 1px solid #353943;
  background: #0f1013;
  color: white;
  padding: 13px 14px;
  border-radius: 10px;
  outline: none;
}
input:focus { border-color: #777; }
button {
  border: 0;
  border-radius: 10px;
  padding: 13px 17px;
  background: #fff;
  color: #111;
  cursor: pointer;
  font-weight: 700;
}
#startScreen button { width: 100%; margin-top: 20px; }
.secondary { background: #252830; color: white; }
.hidden { display: none; }
.muted { color: #9da1aa; }
.small { font-size: 13px; }
.error { color: #ff7777; min-height: 20px; }
.topbar {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 18px; gap: 16px;
}
#roomLabel { color: #9da1aa; font-size: 14px; }
.layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 330px;
  gap: 18px;
}
.videoCard { background: #000; border-radius: 18px; overflow: hidden; }
.videoWrap { aspect-ratio: 16 / 9; }
iframe { width: 100%; height: 100%; display: block; }
.status {
  display: flex; justify-content: space-between;
  padding: 10px 14px; background: #181a1f; color: #aeb2ba;
  font-size: 13px;
}
.chat { display: flex; flex-direction: column; min-height: 420px; }
.messages { flex: 1; overflow-y: auto; min-height: 300px; }
.message { padding: 8px 0; border-bottom: 1px solid #252830; }
.message b { display: block; font-size: 13px; }
.message span { color: #d9dbe0; word-break: break-word; }
#chatForm { display: flex; gap: 8px; margin-top: 12px; }
#chatForm input { min-width: 0; }
#chatForm button { width: 52px; }
.controls { margin-top: 18px; }
.row { display: flex; gap: 8px; }
.row input { flex: 1; }
.row button { white-space: nowrap; }
@media (max-width: 850px) {
  .container { padding: 12px; }
  .layout { grid-template-columns: 1fr; }
  .topbar { align-items: flex-start; flex-direction: column; }
  .chat { min-height: 300px; }
}